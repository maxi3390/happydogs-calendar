# Domain used by Traefik for Host-based routing. For local development
# set this to "localhost"; for a real deployment, set it to the public
# hostname you're serving (e.g. "nursery.example.com"). Required.
DOMAIN=localhost

# URL the Next.js frontend uses to reach the Django API from the browser.
# Must match the scheme and host exposed by Traefik for the /api route.
# Required.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Path to the Docker socket that Traefik reads for service discovery.
# Keep the default unless you run docker on a custom socket path.
# Required.
DOCKER_SOCKET=/var/run/docker.sock

# Cloudflare API token used by Traefik's Let's Encrypt DNS-01 challenge.
# LEAVE BLANK for local development; only required when issuing real TLS
# certificates via Cloudflare in production.
CF_DNS_API_TOKEN=

# Email address Let's Encrypt uses for certificate lifecycle notifications.
# LEAVE BLANK for local development; only required in production when
# issuing real TLS certificates.
ACME_EMAIL=

# Database and Django app
# ================================
# All of the variables in this block have dev defaults baked into
# ``docker-compose.yml`` so a fresh checkout boots with no ``.env``.
# Production deployments MUST override at minimum:
#   - DJANGO_SECRET_KEY  (committed default is public — would let any
#                         attacker forge session cookies / signed urls)
#   - POSTGRES_PASSWORD  (committed default is "nursery", ditto)
#   - DEBUG=False        (leaking stack traces on prod is a real bug)
# Everything else is safe to leave blank in dev; compose's
# ``${VAR:-default}`` fallback picks up the same value the historical
# hardcoded compose used.

# Postgres credentials. The ``db`` service uses these to bootstrap the
# database on first volume init; the ``backend`` and
# ``notification-cron`` services use them to connect. Changing them
# AFTER the volume has data requires either a manual ``ALTER ROLE`` or
# wiping ``postgres_data``.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Where the backend reaches Postgres. Default ``db`` resolves on the
# Docker network. Override only when pointing at an external Postgres
# (managed RDS, separate host, …).
POSTGRES_HOST=
POSTGRES_PORT=

# Django cryptographic secret. Used to sign sessions, password reset
# tokens, signed URLs, etc. MUST be unique per deployment. Generate
# with ``python -c 'import secrets; print(secrets.token_urlsafe(50))'``
# or ``openssl rand -base64 50``.
DJANGO_SECRET_KEY=

# Django DEBUG flag. ``True`` enables the developer error page (with
# stack traces and settings dump) — fine for local dev, NEVER set
# this on a production deployment.
DEBUG=

# Email delivery for notifications
# ================================
# The notification cron sends staff-internal emails when the master
# `notifications` flag is on. Defaults stay on Django's console backend
# so dev stacks print emails to stdout instead of needing real SMTP.
# Set EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend in
# production and fill in EMAIL_HOST / EMAIL_PORT / EMAIL_HOST_USER /
# EMAIL_HOST_PASSWORD / EMAIL_USE_TLS to point at your SMTP relay
# (Mailgun, SES, Postmark, your own server, etc.). The notification
# cron logs a single startup warning if it boots with the console
# backend AND the notifications flag is on, so silent stdout-only
# delivery on prod is loud rather than invisible.

# Django mail backend. Default = console (prints to stdout). Set to
# django.core.mail.backends.smtp.EmailBackend for real delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP host. Required when EMAIL_BACKEND is the SMTP backend.
EMAIL_HOST=localhost

# SMTP port. 587 for STARTTLS, 465 for SMTPS, 25 for plaintext relays.
EMAIL_PORT=25

# SMTP authentication username. LEAVE BLANK for unauthenticated relays
# or the dev console backend.
EMAIL_HOST_USER=

# SMTP authentication password. LEAVE BLANK for unauthenticated relays
# or the dev console backend. Treat as a secret.
EMAIL_HOST_PASSWORD=

# Whether to issue STARTTLS on connect. Set to True for ports 587 / 25
# with TLS, False for the dev console backend or SMTPS (which uses
# implicit TLS via EMAIL_USE_SSL — not exposed here, set in settings).
EMAIL_USE_TLS=False

# From-address staff emails are sent as. Use a real, deliverable
# address in production so bounces have a destination.
DEFAULT_FROM_EMAIL=happy-calendar@localhost

# Object storage (s3 profile)
# ================================
# Opt-in S3-compatible object storage for file uploads (pet / owner
# profile pictures, the system logo, pet documents). When ALL FOUR of
# S3_ENDPOINT_URL / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY /
# S3_BUCKET_NAME are set the backend writes uploads to that bucket
# instead of the local filesystem. When any required var is unset (the
# default for a fresh checkout) the backend keeps writing to MEDIA_ROOT
# under backend/media/, exactly as before this feature.
#
# To turn on the bundled single-node Garage instance:
#   1. Fill in the four required vars + the GARAGE_* secrets below.
#   2. docker compose --profile s3 up -d
#   3. make s3-init
# Or point at any external S3-compatible service (MinIO, AWS S3,
# Backblaze B2, …) by leaving the GARAGE_* vars empty and setting
# S3_ENDPOINT_URL / S3_PUBLIC_ENDPOINT_URL to the external host.
#
# Spec: openspec/specs/backend/file-storage/spec.md
#       openspec/specs/tooling/object-storage/spec.md

# URL the BACKEND uses to reach the bucket. For the bundled Garage
# instance use http://garage:3900 (resolves on the proxy network).
# For AWS use https://s3.<region>.amazonaws.com. Leave empty to keep
# the filesystem default.
S3_ENDPOINT_URL=

# URL baked into client-facing .url responses (the URL the BROWSER
# fetches). Set this when Garage is exposed via a Traefik subdomain
# (https://s3.example.com) different from the internal one. When unset,
# falls back to S3_ENDPOINT_URL — fine for AWS or a single-host
# deployment where the bucket is reachable directly.
S3_PUBLIC_ENDPOINT_URL=

# Bucket credentials. Both required when S3 mode is active. Generate a
# strong secret for production deployments (e.g.
# `openssl rand -base64 24`).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Target bucket. `make s3-init` creates it on the bundled Garage if it
# doesn't already exist.
S3_BUCKET_NAME=happy-calendar-media

# Region label. Garage / MinIO / Backblaze accept any non-empty value;
# AWS requires a real region (e.g. us-east-1). Default suits the
# bundled Garage; override for AWS.
S3_REGION_NAME=garage

# Addressing style. `path` for Garage / MinIO / local dev; `virtual`
# for AWS S3 (which requires DNS-style bucket subdomains).
S3_ADDRESSING_STYLE=path

# When True, .url() returns presigned URLs that expire (more secure
# but breaks <img src> caching). Default False matches the historical
# "everything under /media is publicly readable" behaviour.
S3_QUERYSTRING_AUTH=False

# When true, enables the Traefik route that exposes Garage at
# https://s3.${DOMAIN}. Leave blank/false to keep Garage reachable
# only inside the Docker network — the simplest setup, with the
# backend talking to Garage over the proxy network.
S3_TRAEFIK_ENABLED=false

# Garage internal secrets. Required for Garage to start. Generate
# fresh values for every deployment:
#   GARAGE_RPC_SECRET=$(openssl rand -hex 32)
#   GARAGE_ADMIN_TOKEN=$(openssl rand -hex 32)
#   GARAGE_METRICS_TOKEN=$(openssl rand -hex 32)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=
